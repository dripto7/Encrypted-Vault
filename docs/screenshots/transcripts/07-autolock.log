
### the kernel locks the vault when it goes idle
$ echo 3 > /sys/module/kvault/parameters/autolock_secs
$ cat /proc/kvault/status | grep state     # still unsealed
state:            UNSEALED
$ sleep 5
$ cat /proc/kvault/status | grep -E 'state|key_loaded'
state:            AUTO_LOCKED
key_loaded:       no

$ vaultctl get db_password
vaultctl: KVAULT_GET: Operation not permitted


### unload
$ rmmod kvault && dmesg | tail -2
[ 3805.968850] kvault: auto-locked after 3 s of inactivity
[ 3807.919233] kvault: unloaded, key wiped
