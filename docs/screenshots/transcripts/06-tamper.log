00000000  4c 41 56 4b 01 00 00 00  40 0d 03 00 03 00 00 00  |LAVK....@.......|
00000010  71 b7 6e 30 a8 02 75 ae  e5 54 c1 28 da bd fb ea  |q.n0..u..T.(....|
00000020  d1 3f ff 1e 4b 9f 66 9f  56 12 07 69 d7 79 d3 d3  |.?..K.f.V..i.y..|
00000030  6f 2b 91 8a 14 24 f3 0c  14 d1 72 a8 c1 77 7a e7  |o+...$....r..wz.|
00000040  74 6c 73 5f 6b 65 79 00  00 00 00 00 00 00 00 00  |tls_key.........|
00000050  00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00  |................|
*
00000080  00 00 00 00 02 00 00 00  b2 00 aa 05 a1 01 00 00  |................|

$ strings -a /tmp/kvdemo.vault | grep -c 's3cr3t-db-pa55word'   # the secret
0
$ strings -a /tmp/kvdemo.vault | grep -o 'db_password'          # the NAME is not secret
db_password


### flip one byte, and the import is rejected
$ cmp -l /tmp/kvdemo.vault /tmp/kvdemo.bad | wc -l
4
$ vaultctl import /tmp/kvdemo.bad
vaultctl: KVAULT_IMPORT: Bad message

$ vaultctl get db_password        # the running vault is untouched
s3cr3t-db-pa55word
